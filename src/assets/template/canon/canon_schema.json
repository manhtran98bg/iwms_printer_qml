{
  "require": [
    "mold_no",
    "customer",
    "part_no",
    "customer_part_no",
    "label",
    "product_name_vn",
    "packing_kit",
    "packing_kit_per_box",
    "rev_his",
    "rev",
    "die_no",
    "internal_die_no",
    "shift",
    "production_date",
    "packing_pcs_per_box"
  ],
  "templateFile": "canon_zpl_place_holder.zpl",
  "previewFile": "canon_preview.jpg",
  "routing": {
    "priority": 10,
    "match": {
      "field": "remarks",
      "regex": "^Mau_02$",
      "flags": ""
    }
  },
  "printSettings": {
    "margin_left": 15,
    "margin_top": 20
  },
  "variables": {
    "product_name_vn": {
      "source": "product_name_vn",
      "transform": {
        "type": "truncate",
        "maxLength": 25,
        "suffix": "..."
      }
    },
    "production_date_convert": {
      "source": "production_date",
      "transform": {
        "type": "date",
        "inputFormat": "%d-%m-%y",
        "outputFormat": "%Y%m%d"
      }
    },
    "label_convert": {
      "source": "label",
      "transform": {
        "type": "padNumericSuffix",
        "length": 4,
        "character": "0"
      }
    }
  },
  "computedFields": {
    "qty_box_barcode": {
      "template": "{part_no}-{internal_die_no}/O{packing_pcs_per_box}{production_date}"
    },
    "qr_code": {
      "template": "LA,{customer_part_no}/{internal_die_no}/N278/{production_date_convert}/{label_convert}/{packing_pcs_per_box}/{rev}//"
    }
  },
  "defaults": {
    "customer": "CANON VIỆT NAM (TL)",
    "label": "7",
    "mold_no": "269V-230",
    "customer_part_no": "QC5-1076-000",
    "part_no": "QC5-1076",
    "product_name_vn": "Trục bánh răng bộ phận",
    "packing_kit": "KIT 604",
    "rev_his": "05/05",
    "rev": "005",
    "packing_kit_per_box": "4",
    "die_no": "V1",
    "internal_die_no": "V01",
    "shift": "1     2",
    "production_date": "18-06-26",
    "packing_pcs_per_box": "2000"
  }
}
